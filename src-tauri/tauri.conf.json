{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Netrix",
  "version": "0.3.0-beta.8",
  "identifier": "com.netrix.app",
  "build": {
    "beforeDevCommand": "npm run dev --prefix frontend",
    "beforeBuildCommand": "npm run build --prefix frontend && npm run build:sidecar:release",
    "frontendDist": "../frontend/dist",
    "devUrl": "http://localhost:3000"
  },
  "app": {
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset: http://asset.localhost; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost http://tauri.localhost ws://localhost:* http://localhost:* ws://127.0.0.1:* http://127.0.0.1:*",
      "capabilities": ["main-capability", "detached-terminal-capability", "detached-map-capability"]
    },
    "windows": [
      {
        "title": "Netrix",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 640,
        "decorations": false,
        "transparent": false,
        "visible": false
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "licenseFile": "../LICENSE",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": { "../LICENSE": "LICENSE" },
    "externalBin": ["binaries/netrix_backend"],
    "windows": {
      "nsis": {
        "installerHooks": "windows/runtime-hooks.nsh",
        "installerIcon": "icons/icon.ico",
        "headerImage": "icons/header.bmp",
        "sidebarImage": "icons/sidebar.bmp"
      },
      "webviewInstallMode": {
        "type": "offlineInstaller"
      }
    }
  }
}
